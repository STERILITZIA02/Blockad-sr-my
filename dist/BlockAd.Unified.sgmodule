#!name=BlockAd · 统一稳定版
#!desc=Shadowrocket 优先的去广告统一模块；按精确接口持续过滤，失败时保留原响应。不要与 components 内模块重复启用。
#!author=STERILITZIA02
#!homepage=https://github.com/STERILITZIA02/Blockad-sr-my
#!version=1.1.1
#!updated=2026-07-26
#!category=去广告

# GENERATED FILE — 请修改 config/apps.mjs / config/legacy-apps.mjs 后重新构建。
# source-ref=main

[Rule]

# --- 通用广告网络 ---
RULE-SET,https://raw.githubusercontent.com/STERILITZIA02/Blockad-sr-my/main/dist/rules/AWAvenue-Ads-Rule.list,REJECT

# --- 知乎 ---
DOMAIN,ad.zhihu.com,REJECT

# --- YouTube / YouTube Music ---
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT

# --- 抖音 ---
DOMAIN,api.iegadp.qq.com,REJECT
DOMAIN,p6-ad-sign.byteimg.com,REJECT
DOMAIN,p9-ad-sign.byteimg.com,REJECT

# --- 迅雷 ---
DOMAIN,cpm.cm.sandai.net,REJECT

# --- 网易云音乐 ---
DOMAIN,iadmat.nosdn.127.net,REJECT

# --- 什么值得买 ---
DOMAIN,aaid.uyunad.com,REJECT
DOMAIN-SUFFIX,res-ga.smzdm.com,REJECT

# --- 喜马拉雅 ---
DOMAIN,adsehera.ximalaya.com,REJECT
DOMAIN,adbehavior.ximalaya.com,REJECT
DOMAIN,adbehavior.wsa.ximalaya.com,REJECT
DOMAIN-SUFFIX,ad.ximalaya.com,REJECT
DOMAIN-SUFFIX,adse.ximalaya.com,REJECT
DOMAIN-SUFFIX,adse-v2.ximalaya.com,REJECT

# --- 小红书 ---
DOMAIN,t-ads.xiaohongshu.com,REJECT

# --- 酷我音乐 ---
DOMAIN,rich.kuwo.cn,REJECT
DOMAIN-SUFFIX,ad.kuwo.cn,REJECT
DOMAIN-SUFFIX,deliver.kuwo.cn,REJECT

# --- 超级课程表 / SuperFriday ---
DOMAIN,ad.myfriday.cn,REJECT

[URL Rewrite]

# --- QQ / 腾讯系广告 ---
# GDT 广告拉取/点击；只清空广告载荷，不整域断开 SDK
^https:\/\/(?:mi|v2mi|win)\.gdt\.qq\.com\/gdt_(?:mview|view|click)\.fcg(?:\?|$) - reject-dict
# 腾讯新闻开屏
^https:\/\/r\.inews\.qq\.com\/getFullScreenPic(?:\?|$) - reject-dict
# 腾讯新闻当前开屏与横幅广告
^https:\/\/r\.inews\.qq\.com\/(?:getBannerAds|getSplash)(?:\?|$) - reject-dict

# --- 微信 ---
# 公众号文章联盟商品广告
^https:\/\/mp\.weixin\.qq\.com\/mp\/cps_product_info(?:\?|$) - reject-dict

# --- 京东 ---
# 明确商品广告素材接口
^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#&]+&)*functionId=queryMaterialAdverts(?:&|$) - reject-dict
# 关闭首页直播推广小窗；仅匹配该广告组件接口
^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#&]+&)*functionId=getWidgetV1052(?:&|$) - reject-dict
# 首页营销推荐规则；不匹配订单、物流或系统通知
^https:\/\/lop-proxy\.jd\.com\/queryAppHomePageMarketingRecommendRuleConfigInfo(?:\?|$) - reject-dict

# --- 淘宝 / 天猫 ---
# 淘宝/天猫开屏配置
^https:\/\/(?:guide-acs|acs)\.m\.(?:taobao|tmall)\.com\/gw\/mtop\.taobao\.wireless\.home\.(?:splash|newface)\.awesome\.get\/ - reject-dict
# 阿里广告服务
^https:\/\/(?:guide-acs|acs)\.m\.(?:taobao|tmall)\.com\/gw\/mtop\.alibaba\.advertisementservice\.getadv\/ - reject-dict
# 淘宝当前 AI 开屏
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.aicloud\.splash(?:\/|$) - reject-dict
# 淘宝营销 PopLayer 模板；不匹配业务 API
^https:\/\/poplayer\.template\.alibaba\.com\/[A-Za-z0-9_]+\.json(?:\?|$) - reject-dict

# --- 知乎 ---
# 开屏与顶部商业横幅
^https:\/\/api\.zhihu\.com\/commercial_api\/(?:banners_v3\/(?:app_topstory_banner|mobile_banner)|launch_v2|real_time_launch_v2|app_float_layer)(?:\?|$) - reject-dict
# 回答/文章底部商业卡片
^https:\/\/api\.zhihu\.com\/commercial_api\/(?:answer|article)\/\d+\/bottom-v2(?:\?|$) - reject-dict
# 广告样式与网页商业卡片
^https:\/\/api\.zhihu\.com\/(?:ad-style-service\/request|distribute\/rhea\/qa_ad_card\/h5\/recommendation)(?:\?|$) - reject-dict
# 品牌问题卡片
^https:\/\/(?:api\.zhihu\.com\/brand\/question\/\d+\/card|www\.zhihu\.com\/api\/v\d+\/brand\/question\/\d+\/card)(?:\?|$) - reject-dict
# 知乎网页品牌广告资源
^https:\/\/zhstatic\.zhihu\.com\/brand-ad(?:\/|$) - reject

# --- 微博 / 微博轻享版 ---
# 微博开屏
^https:\/\/wbapp\.mobile\.sina\.cn\/wbapplua\/wbpullad\.lua(?:\?|$) - reject-dict
# 微博 SDK 广告
^https:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/(?:actionad|sdkad)\.php(?:\?|$) - reject-dict
# 微博当前实时/预加载开屏广告
^https:\/\/boot(?:realtime|preload)\.uve\.weibo\.com\/v\d+\/ad\/(?:realtime|preload)(?:\?|$) - reject-dict
# 微博第一方广告预加载；不匹配通知激活接口
^https:\/\/api\.weibo\.cn\/2\/ad\/preload(?:\?|$) - reject-dict
# 微博长文章广告位；保留打赏接口
^https:\/\/(?:card\.weibo\.com\/article|weibo\.com\/ttarticle)\/m\/aj\/uvead(?:\?|$) - reject-dict

# --- 闲鱼 ---
# 闲鱼开屏
^https:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlecommerce\.splash\.ads(?:\/|$) - reject-dict

# --- YouTube / YouTube Music ---
# YouTube 广告曝光与点击统计
^https:\/\/(?:www|s)\.youtube\.com\/(?:api\/stats\/ads|pagead|ptracking)(?:\?|\/|$) - reject-200
# 仅拒绝带 adcontext 的 QoE 广告统计
^https:\/\/s\.youtube\.com\/api\/stats\/qoe\?(?=[^#]*\badcontext\b) - reject-200

# --- 百度网盘 ---
# 网盘广告接口
^https:\/\/pan\.baidu\.com\/rest\/(?:\d+\.\d+|[^/]+)\/pcs\/adx(?:\?|$) - reject-dict
# 网盘广告接口
^https:\/\/pan\.baidu\.com\/rest\/2\.0\/pcs\/ad(?:\?|$) - reject-dict
# 启动活动入口
^https:\/\/pan\.baidu\.com\/act\/api\/activityentry(?:\?|$) - reject-dict
# 明确命名的广告资源
^https:\/\/issuecdn\.baidupcs\.com\/issue\/netdisk\/guanggao(?:\/|$) - reject
# 仅阻断更新统计，不阻断 App 更新
^https:\/\/update\.pan\.baidu\.com\/statistics(?:\?|$) - reject-200

# --- 抖音 ---
# 穿山甲广告拉取与配置；保持 SDK 握手域可连接，避免断连重试
^https:\/\/api-access\.pangolin-sdk-toutiao(?:[1-5]|-b)?\.com\/api\/ad\/union\/sdk\/(?:get_ads|settings)\/ - reject-dict
# 穿山甲备用广告拉取与配置；仅匹配广告载荷路径
^https:\/\/api\.pangolin-sdk-toutiao(?:[1-5]|-b)?\.com\/api\/ad\/union\/sdk\/(?:get_ads|settings)\/ - reject-dict
# Gromore 广告配置与竞价
^https:\/\/gromore\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/mediation\/(?:config|exchange)(?:\/|$) - reject-dict
# 穿山甲广告落地页包；不阻断 SDK 配置或遥测连接
^https:\/\/ether-pack\.pangolin-sdk-toutiao\.com\/union\/endcard(?:\/|$) - reject-200
# 穿山甲 sf3 明确广告渲染素材
^https:\/\/sf3-fe-tos\.pglstatp-toutiao\.com\/obj\/ad-pattern(?:\/|$) - reject-200
# 穿山甲 sf6 明确广告渲染素材
^https:\/\/sf6-fe-tos\.pglstatp-toutiao\.com\/obj\/ad-pattern(?:\/|$) - reject-200

# --- 迅雷 ---
# 迅雷广告图片
^https:\/\/images\.client\.vip\.xunlei\.com\/[^?#]+\/advert\/ - reject-img
# 迅雷广告位批量接口
^https:\/\/api-shoulei-ssl\.xunlei\.com\/flowhub\/v\d+\/slots:batchGet(?:\?|$) - reject-dict

