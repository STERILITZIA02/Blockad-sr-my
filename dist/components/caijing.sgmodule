[URL Rewrite]
# 广告接口
^https:\/\/api\.caijingmobile\.com\/(?:ad|advert)(?:\/|\?|$) - reject-dict
# iOS 启动广告
^https:\/\/m\.caijing\.com\.cn\/startup_ad_ios\.html(?:\?|$) - reject-200

[MITM]
hostname = %APPEND% api.caijingmobile.com, m.caijing.com.cn
