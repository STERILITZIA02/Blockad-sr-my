[URL Rewrite]
# App 广告
^https:\/\/ccsp-egmas\.sf-express\.com\/cx-app-base\/base\/app\/ad(?:\/|\?|$) - reject-dict
# 信息流广告
^https:\/\/ucmp\.sf-express\.com\/proxy\/operation-platform\/info-flow-adver\/query(?:\?|$) - reject-dict

[MITM]
hostname = %APPEND% ccsp-egmas.sf-express.com, ucmp.sf-express.com
