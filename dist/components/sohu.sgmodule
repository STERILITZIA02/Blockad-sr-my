[URL Rewrite]
# 广告接口
^https:\/\/api\.k\.sohu\.com\/api\/news\/adsense(?:\?|$) - reject-dict
# 推广素材
^https:\/\/pic\.k\.sohu\.com\/img\d+\/wb\/tj(?:\/|$) - reject-img

[MITM]
hostname = %APPEND% api.k.sohu.com, pic.k.sohu.com
