[URL Rewrite]
# 广告素材
^https:\/\/image\.suning\.cn\/uimg\/ma\/ad(?:\/|$) - reject-img
# 广告位
^https:\/\/mpcs\.suning\.com\/mpcs\/dm\/getDmInfo(?:\?|$) - reject-dict

[MITM]
hostname = %APPEND% image.suning.cn, mpcs.suning.com
