#!name=BlockAd · 什么值得买
#!desc=启动广告、thirdAd 与混合页面中的强标记广告；不修改会员或优惠权益。
#!author=STERILITZIA02
#!homepage=https://github.com/STERILITZIA02/Blockad-sr-my
#!version=1.1.0
#!updated=2026-07-26
#!category=去广告

# GENERATED FILE — 请修改 config/apps.mjs / config/legacy-apps.mjs 后重新构建。
# source-ref=main

[Rule]
DOMAIN,aaid.uyunad.com,REJECT
DOMAIN-SUFFIX,res-ga.smzdm.com,REJECT

[URL Rewrite]
# 启动广告
^https:\/\/(?:api|app-api)\.smzdm\.com\/(?:v\d+\/)?util\/loading(?:\?|$) - reject-dict
# 第三方广告
^https:\/\/s\d+\.zdmimg\.com\/www\/api\/v\d+\/api\/thirdAd\.php(?:\?|$) - reject-dict

[Script]
什么值得买_首页列表显式广告 = type=http-response,pattern=^https:\/\/(?:homepage-api\.smzdm\.com\/v3\/home|haojia-api\.smzdm\.com\/(?:home\/list|ranking_list\/articles)|s-api\.smzdm\.com\/sou\/list_v10)(?:\?|$),requires-body=1,max-size=2097152,timeout=5,script-path=https://raw.githubusercontent.com/STERILITZIA02/Blockad-sr-my/main/dist/scripts/blockad-router.js

[MITM]
hostname = %APPEND% api.smzdm.com, app-api.smzdm.com, *.zdmimg.com, homepage-api.smzdm.com, haojia-api.smzdm.com, s-api.smzdm.com
