[URL Rewrite]
# 广告展示
^https:\/\/(?:guide-acs\.m\.taobao|[^/]+\.cainiao)\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.mshow(?:\.cn)?(?:\/|\?|$) - reject-dict
# 飞行广告
^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.cainiao\.adx\.flyad\.getad(?:\/|\?|$) - reject-dict

[MITM]
hostname = %APPEND% guide-acs.m.taobao.com, *.cainiao.com
