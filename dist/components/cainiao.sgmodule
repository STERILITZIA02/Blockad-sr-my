#!name=BlockAd · 菜鸟
#!desc=两个精确 MTop 主机上的 ads.mshow/flyad 广告接口；不解密整个菜鸟域，保留物流、取件、寄件和账号。
#!author=STERILITZIA02
#!homepage=https://github.com/STERILITZIA02/Blockad-sr-my
#!version=1.1.2
#!updated=2026-07-28
#!category=去广告

# GENERATED FILE — 请修改 config/apps.mjs / config/legacy-apps.mjs 后重新构建。
# source-ref=main

[URL Rewrite]
# 广告展示
^https:\/\/(?:guide-acs\.m\.taobao\.com|cn-acs\.m\.cainiao\.com)\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.mshow(?:\.cn)?(?:\/|\?|$) - reject-dict
# 飞行广告
^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.cainiao\.adx\.flyad\.getad(?:\/|\?|$) - reject-dict

[MITM]
hostname = %APPEND% guide-acs.m.taobao.com, cn-acs.m.cainiao.com
