# GENERATED FILE — 请修改 config/apps.mjs / config/legacy-apps.mjs 后重新构建。
# source-ref=main

[URL Rewrite]
# 启动广告
^https:\/\/mime\.baidu\.com\/v\d+\/IosStart\/getStartInfo(?:\?|$) - reject-dict
# 活动广告
^https:\/\/mime\.baidu\.com\/v\d+\/activity\/advertisement(?:\/|\?|$) - reject-dict

[MITM]
hostname = %APPEND% mime.baidu.com
