#!category=去广告

# GENERATED FILE — 请修改 config/apps.mjs / config/legacy-apps.mjs 后重新构建。
# source-ref=main

[URL Rewrite]
# 小米金融广告
^https:\/\/api\.jr\.mi\.com\/v\d+\/adv(?:\/|\?|$) - reject-dict
# 小米金融开屏
^https:\/\/api\.jr\.mi\.com\/jr\/api\/playScreen(?:\?|$) - reject-dict
# 小米运动明确广告
^https:\/\/api-mifit\.huami\.com\/discovery\/mi\/discovery\/[^/?#]+_ad(?:\?|$) - reject-dict
# Zepp 国内版开屏与首页广告
^https:\/\/api-mifit-cn2\.zepp\.com\/discovery\/mi\/cards\/(?:startpage_ad|homepage_ad)(?:\?|$) - reject-dict

[MITM]
hostname = %APPEND% api.jr.mi.com, api-mifit.huami.com, api-mifit-cn2.zepp.com
