#!category=去广告

# GENERATED FILE — 请修改 config/apps.mjs / config/legacy-apps.mjs 后重新构建。
# source-ref=main

[Rule]
DOMAIN,ad.zijieapi.com,REJECT
DOMAIN,ads3-normal.zijieapi.com,REJECT
DOMAIN,ads5-normal.zijieapi.com,REJECT
DOMAIN,api.iegadp.qq.com,REJECT
DOMAIN,p6-ad-sign.byteimg.com,REJECT
DOMAIN,p9-ad-sign.byteimg.com,REJECT
DOMAIN,pglstatp-toutiao.com,REJECT

[URL Rewrite]
# 穿山甲广告拉取与配置；保持 SDK 握手域可连接，避免断连重试
^https:\/\/api-access\.pangolin-sdk-toutiao(?:[1-5]|-b)?\.com\/api\/ad\/union\/sdk\/(?:get_ads|settings)\/ - reject-dict
# 穿山甲备用广告拉取与配置；仅匹配广告载荷路径
^https:\/\/api\.pangolin-sdk-toutiao(?:[1-5]|-b)?\.com\/api\/ad\/union\/sdk\/(?:get_ads|settings)\/ - reject-dict
# Gromore 广告配置与竞价
^https:\/\/gromore\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/mediation\/(?:config|exchange)(?:\/|$) - reject-dict
# 穿山甲广告落地页包；不阻断 SDK 配置或遥测连接
^https:\/\/ether-pack\.pangolin-sdk-toutiao\.com\/union\/endcard(?:\/|$) - reject-200
# 穿山甲 sf3 明确广告渲染素材
^https:\/\/sf3-fe-tos\.pglstatp-toutiao\.com\/obj\/ad-pattern(?:\/|$) - reject-200
# 穿山甲 sf6 明确广告渲染素材
^https:\/\/sf6-fe-tos\.pglstatp-toutiao\.com\/obj\/ad-pattern(?:\/|$) - reject-200

[MITM]
hostname = %APPEND% api-access.pangolin-sdk-toutiao.com, api-access.pangolin-sdk-toutiao-b.com, api-access.pangolin-sdk-toutiao1.com, api-access.pangolin-sdk-toutiao2.com, api-access.pangolin-sdk-toutiao3.com, api-access.pangolin-sdk-toutiao4.com, api-access.pangolin-sdk-toutiao5.com, api.pangolin-sdk-toutiao.com, api.pangolin-sdk-toutiao-b.com, api.pangolin-sdk-toutiao1.com, api.pangolin-sdk-toutiao2.com, api.pangolin-sdk-toutiao3.com, api.pangolin-sdk-toutiao4.com, api.pangolin-sdk-toutiao5.com, gromore.pangolin-sdk-toutiao.com, ether-pack.pangolin-sdk-toutiao.com, sf3-fe-tos.pglstatp-toutiao.com, sf6-fe-tos.pglstatp-toutiao.com
