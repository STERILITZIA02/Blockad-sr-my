#!name=BlockAd · 抖音
#!desc=穿山甲/Gromore 广告 SDK 的拉取、配置与明确广告素材；不解密或改写抖音主业务 feed。
#!author=STERILITZIA02
#!homepage=https://github.com/STERILITZIA02/Blockad-sr-my
#!version=1.1.1
#!updated=2026-07-26
#!category=去广告

# GENERATED FILE — 请修改 config/apps.mjs / config/legacy-apps.mjs 后重新构建。
# source-ref=main

[Rule]
DOMAIN,ad.zijieapi.com,REJECT
DOMAIN,ads3-normal.zijieapi.com,REJECT
DOMAIN,ads5-normal.zijieapi.com,REJECT
DOMAIN,api-access.pangolin-sdk-toutiao.com,REJECT
DOMAIN,api-access.pangolin-sdk-toutiao-b.com,REJECT
DOMAIN,api.iegadp.qq.com,REJECT
DOMAIN,activity-ag.awemeughun.com,REJECT
DOMAIN,gromore.pangolin-sdk-toutiao.com,REJECT
DOMAIN,p6-ad-sign.byteimg.com,REJECT
DOMAIN,p9-ad-sign.byteimg.com,REJECT
DOMAIN,pglstatp-toutiao.com,REJECT

[URL Rewrite]
# 穿山甲广告拉取与配置
^https:\/\/api-access(?:[1-5])?\.pangolin-sdk-toutiao(?:-b)?\.com\/api\/ad\/union\/sdk\/(?:get_ads|settings)\/ - reject-dict
# Gromore 广告配置与竞价
^https:\/\/gromore\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/mediation\/(?:config|exchange)(?:\/|$) - reject-dict
# 明确广告渲染素材
^https:\/\/[^/]+\.pglstatp-toutiao\.com\/obj\/ad-pattern\/renderer(?:\/|$) - reject
# 只匹配带 from=ad 的旧广告马赛克素材
^https:\/\/[^/]+\.pstatp\.com\/obj\/mosaic-legacy\/[^?]+\?(?=[^#]*\bfrom=ad(?:&|$)) - reject
# 抖音第一方明确广告接口；不匹配普通 feed 或播放接口
^https:\/\/[^/]+\.amemv\.com\/aweme\/v\d+\/ad\/ - reject-dict
# 字节系明确命名的 API/Motor 广告接口
^https:\/\/[^/]+\.(?:amemv|snssdk)\.com\/(?:api|motor)\/ad\/ - reject-dict

[MITM]
hostname = %APPEND% api-access.pangolin-sdk-toutiao.com, api-access.pangolin-sdk-toutiao-b.com, api-access1.pangolin-sdk-toutiao.com, api-access2.pangolin-sdk-toutiao.com, api-access3.pangolin-sdk-toutiao.com, api-access4.pangolin-sdk-toutiao.com, api-access5.pangolin-sdk-toutiao.com, gromore.pangolin-sdk-toutiao.com, *.pglstatp-toutiao.com, *.pstatp.com, *.amemv.com, *.snssdk.com
