#!name=BlockAd · 网易云音乐
#!desc=第一方 ad API 与明确广告域；保留音乐播放、歌单、评论和账号。
#!author=STERILITZIA02
#!homepage=https://github.com/STERILITZIA02/Blockad-sr-my
#!version=1.1.1
#!updated=2026-07-26
#!category=去广告

# GENERATED FILE — 请修改 config/apps.mjs / config/legacy-apps.mjs 后重新构建。
# source-ref=main

[Rule]
DOMAIN,iadmat.nosdn.127.net,REJECT
DOMAIN,iadmusicmat.music.126.net,REJECT

[URL Rewrite]
# 广告 API
^https:\/\/(?:ipv4\.|interface\d*\.)?music\.163\.com\/(?:w?e?api|eapi)\/ad(?:\/|\?|$) - reject-dict

[MITM]
hostname = %APPEND% music.163.com, *.music.163.com
