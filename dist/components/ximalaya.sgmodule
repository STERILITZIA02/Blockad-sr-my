# GENERATED FILE — 请修改 config/apps.mjs / config/legacy-apps.mjs 后重新构建。
# source-ref=main

[Rule]
DOMAIN,adsehera.ximalaya.com,REJECT
DOMAIN,adse.wsa.ximalaya.com,REJECT
DOMAIN,adbehavior.ximalaya.com,REJECT
DOMAIN,adbehavior.wsa.ximalaya.com,REJECT
DOMAIN-SUFFIX,ad.ximalaya.com,REJECT
DOMAIN-SUFFIX,adse.ximalaya.com,REJECT
DOMAIN-SUFFIX,adse-v2.ximalaya.com,REJECT

[Script]
喜马拉雅_信息流显式广告 = type=http-response,pattern=^https:\/\/(?:mobile|mobilehera|mobwsa)\.ximalaya\.com\/(?:discovery-feed\/v\d+\/mix|football-portal\/diff2\/batch|mobile-playpage\/playpage\/tabs\/v2)(?:\/|\?|$),requires-body=1,max-size=2097152,timeout=5,script-path=https://raw.githubusercontent.com/STERILITZIA02/Blockad-sr-my/main/dist/scripts/blockad-router.js

[MITM]
hostname = %APPEND% mobile.ximalaya.com, mobilehera.ximalaya.com, mobwsa.ximalaya.com
