# GENERATED FILE — 请修改 config/apps.mjs / config/legacy-apps.mjs 后重新构建。
# source-ref=main

[URL Rewrite]
# 书城广告
^https:\/\/ih2\.ireader\.com\/zyapi\/bookstore\/ad(?:\/|\?|$) - reject-dict
# 开屏广告
^https:\/\/ih2\.ireader\.com\/zyapi\/self\/screen\/ad(?:\/|\?|$) - reject-dict
# 广告接口
^https:\/\/ih2\.ireader\.com\/zycl\/api\/ad(?:\/|\?|$) - reject-dict

[MITM]
hostname = %APPEND% ih2.ireader.com
