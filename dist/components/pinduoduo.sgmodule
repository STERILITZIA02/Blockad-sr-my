[Rule]
DOMAIN,t-dsp.pinduoduo.com,REJECT

[URL Rewrite]
# 开屏广告
^https:\/\/api\.(?:pinduoduo|yangkeduo)\.com\/api\/cappuccino\/splash(?:\?|$) - reject-dict

[MITM]
hostname = %APPEND% api.pinduoduo.com, api.yangkeduo.com
