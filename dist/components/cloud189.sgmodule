[URL Rewrite]
# 开屏目录
^https:\/\/cloud\.189\.cn\/include\/splash(?:\/|$) - reject-img
# 开屏广告
^https:\/\/api\.cloud\.189\.cn\/guns\/getOpenscreenBanners(?:\?|$) - reject-dict

[MITM]
hostname = %APPEND% cloud.189.cn, api.cloud.189.cn
