# GENERATED FILE — 请修改 config/apps.mjs / config/legacy-apps.mjs 后重新构建。
# source-ref=main

[URL Rewrite]
# 大众点评开屏
^https:\/\/mapi\.dianping\.com\/mapi\/operating\/(?:indexopsmodules|loadsplashconfig)(?:\?|$) - reject-dict
# 大众点评广告购物位
^https:\/\/mapi\.dianping\.com\/adshopping(?:\?|$) - reject-dict
# 美团启动图
^https:\/\/wmapi\.meituan\.com\/api\/v\d+\/(?:openscreen|startpicture)(?:\?|$) - reject-dict
# 美团小程序广告
^https:\/\/rms\.meituan\.com\/api\/v\d+\/rmsmina\/c\/queryWechatAdvertisement(?:\?|$) - reject-dict

[Script]
大众点评_首页显式广告 = type=http-response,pattern=^https:\/\/mapi\.dianping\.com\/mapi\/intelliindex(?:\?|$),requires-body=1,max-size=2097152,timeout=5,script-path=https://raw.githubusercontent.com/STERILITZIA02/Blockad-sr-my/main/dist/scripts/blockad-router.js

[MITM]
hostname = %APPEND% mapi.dianping.com, wmapi.meituan.com, rms.meituan.com
