[URL Rewrite]
# 广告 API
^https:\/\/api\.gaoqingdianshi\.com\/api\/v\d+\/ad(?:\/|\?|$) - reject-dict
# 广告素材
^https:\/\/cdn\.dianshihome\.com\/static\/ad(?:\/|$) - reject-img

[MITM]
hostname = %APPEND% api.gaoqingdianshi.com, cdn.dianshihome.com
