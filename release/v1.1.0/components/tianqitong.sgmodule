[URL Rewrite]
# SDK 广告
^https:\/\/tqt\.weibo\.cn\/overall\/redirect\.php\?(?=[^#]*\br=(?:tqt_sdkad|tqtad)(?:&|$)) - reject-dict
# 广告接口
^https:\/\/tqt\.weibo\.cn\/(?:[^?#]*advert\.index|api\/advert)(?:\/|\?|$) - reject-dict

[MITM]
hostname = %APPEND% tqt.weibo.cn
