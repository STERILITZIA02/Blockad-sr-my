[URL Rewrite]
# 广告配置树
^https:\/\/api-release\.wuta-cam\.com\/ad_tree(?:\?|$) - reject-dict
# 广告组件缓存
^https:\/\/res-release\.wuta-cam\.com\/json\/ads_component_cache\.json(?:\?|$) - reject-dict

[MITM]
hostname = %APPEND% api-release.wuta-cam.com, res-release.wuta-cam.com
