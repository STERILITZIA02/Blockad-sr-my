[URL Rewrite]
# 广告配置
^https:\/\/portal-xunyou\.qingcdn\.com\/api\/v\d+\/ios\/configs\/(?:splash_ad|ad_urls)(?:\?|$) - reject-dict
# 广告接口
^https:\/\/portal-xunyou\.qingcdn\.com\/api\/v\d+\/ios\/ads(?:\/|\?|$) - reject-dict

[MITM]
hostname = %APPEND% portal-xunyou.qingcdn.com
