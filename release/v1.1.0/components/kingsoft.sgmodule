#!name=BlockAd · WPS / 金山词霸
#!desc=广告统计、广告服务、开屏和 feeds_ad 素材；不修改会员或文档功能。
#!author=STERILITZIA02
#!homepage=https://github.com/STERILITZIA02/Blockad-sr-my
#!version=1.1.0
#!updated=2026-07-26
#!category=去广告

# GENERATED FILE — 请修改 config/apps.mjs / config/legacy-apps.mjs 后重新构建。
# source-ref=v1.1.0

[URL Rewrite]
# WPS 广告统计
^https:\/\/ios\.wps\.cn\/ad-statistics-service(?:\/|\?|$) - reject-200
# 金山广告服务
^https:\/\/[^/]+\.kingsoft-office-service\.com\/ad(?:\/|\?|$) - reject-dict
# 词霸广告请求
^https:\/\/dict-mobile\.iciba\.com\/interface\/index\.php\?(?=[^#]*(?:\bc=ad\b|collectFeedsAdShowCount|KSFeedsAdCardViewController)) - reject-dict
# 词霸开屏
^https:\/\/service\.iciba\.com\/popo\/open\/screens\/v\d+\?(?=[^#]*\badjson\b) - reject-dict
# 词霸信息流广告素材
^https:\/\/mobile-pic\.cache\.iciba\.com\/feeds_ad(?:\/|$) - reject-img

[MITM]
hostname = %APPEND% ios.wps.cn, *.kingsoft-office-service.com, dict-mobile.iciba.com, service.iciba.com, mobile-pic.cache.iciba.com
