# GENERATED FILE — 请修改 config/apps.mjs / config/legacy-apps.mjs 后重新构建。
# source-ref=v1.1.0

[URL Rewrite]
# 广告接口
^https:\/\/app\.poizon\.com\/api\/v\d+\/app\/advertisement(?:\/|\?|$) - reject-dict
# 广告接口（新主机）
^https:\/\/app\.dewu\.com\/api\/v\d+\/app\/advertisement(?:\/|\?|$) - reject-dict

[MITM]
hostname = %APPEND% app.poizon.com, app.dewu.com
