[URL Rewrite]
# 营销屏资源
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.crm\.screen\.(?:allresource|predict)(?:\/|\?|$) - reject-dict
# 启动活动资源
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.trip\.activity\.querytmsresources\/1\.0\?(?=[^#]*\btype=originaljson(?:&|$)) - reject-dict

[MITM]
hostname = %APPEND% acs.m.taobao.com
