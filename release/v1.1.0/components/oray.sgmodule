[URL Rewrite]
# 广告接口
^https:\/\/slapi\.oray\.net\/(?:client\/ad|adver)(?:\/|\?|$) - reject-dict
# iOS 启动与推广素材
^https:\/\/client-api-v2\.oray\.com\/materials\/(?:SUNLOGIN_CLIENT_IOS_PROMOTION|SLCC_IOS_STARTUP)(?:\?|$) - reject-dict

[MITM]
hostname = %APPEND% slapi.oray.net, client-api-v2.oray.com
