[URL Rewrite]
# 邮箱广告配置
^https:\/\/appconf\.mail\.163\.com\/mmad(?:\/|\?|$) - reject-dict
# 客户端广告配置
^https:\/\/client\.mail\.163\.com\/apptrack\/confinfo\/(?:searchMultiAds|showAds)(?:\.do)?(?:\?|$) - reject-dict

[MITM]
hostname = %APPEND% appconf.mail.163.com, client.mail.163.com
