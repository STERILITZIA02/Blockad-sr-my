# GENERATED FILE — 请修改 config/apps.mjs / config/legacy-apps.mjs 后重新构建。
# source-ref=v1.1.0

[URL Rewrite]
# 酒店广告接口
^https:\/\/hweb-manager\.huazhu\.com\/hotels\/ad(?:\/|\?|$) - reject-dict

[Script]
华住会_弹窗内显式广告 = type=http-response,pattern=^https:\/\/hweb-manager\.huazhu\.com\/notice\/getAppPopupNotifyAlert(?:\?|$),requires-body=1,max-size=1048576,timeout=5,script-path=https://raw.githubusercontent.com/STERILITZIA02/Blockad-sr-my/v1.1.0/release/v1.1.0/scripts/blockad-router.js

[MITM]
hostname = %APPEND% hweb-manager.huazhu.com
