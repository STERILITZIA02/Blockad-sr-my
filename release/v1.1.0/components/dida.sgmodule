[URL Rewrite]
# 广告服务
^https:\/\/capis(?:-slb)?\.didapinche\.com\/ad(?:\/|\?|$) - reject-dict
# 广告统计
^https:\/\/www\.didapinche\.com\/app\/adstat(?:\/|\?|$) - reject-200

[MITM]
hostname = %APPEND% capis.didapinche.com, capis-slb.didapinche.com, www.didapinche.com
