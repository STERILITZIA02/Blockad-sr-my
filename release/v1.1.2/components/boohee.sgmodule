[URL Rewrite]
# 设备页推广横幅
^https:\/\/api\.boohee\.com\/meta-interface\/v1\/index\/sensor-banners(?:\?|$) - reject-dict
# 营销弹窗配置
^https:\/\/bohe\.sfo-tx-shanghai-01\.saas\.sensorsdata\.cn\/api\/v2\/sfo\/user_popup_configs(?:\?|$) - reject-dict

[Script]
薄荷健康_首页显式广告 = type=http-response,pattern=^https:\/\/api\.boohee\.com\/meta-interface\/(?:v2\/index|v1\/index\/plaza)(?:\?|$),requires-body=1,max-size=2097152,timeout=5,script-path=https://raw.githubusercontent.com/STERILITZIA02/Blockad-sr-my/v1.1.2/release/v1.1.2/scripts/blockad-router.js

[MITM]
hostname = %APPEND% api.boohee.com, bohe.sfo-tx-shanghai-01.saas.sensorsdata.cn
