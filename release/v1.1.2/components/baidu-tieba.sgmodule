#!name=BlockAd · 百度贴吧
#!desc=开屏、吧内广告配置与 JSON 信息流显式广告；Protobuf 无法解析时原样返回。
#!author=STERILITZIA02
#!homepage=https://github.com/STERILITZIA02/Blockad-sr-my
#!version=1.1.2
#!updated=2026-07-28
#!category=去广告

# GENERATED FILE — 请修改 config/apps.mjs / config/legacy-apps.mjs 后重新构建。
# source-ref=v1.1.2

[URL Rewrite]
# 开屏日程
^https:\/\/c\.tieba\.baidu\.com\/c\/s\/splashSchedule(?:\?|$) - reject-dict
# 吧内广告配置
^https:\/\/c\.tieba\.baidu\.com\/c\/f\/forum\/getAdInfo(?:\?|$) - reject-dict
# 开屏广告专用入口
^https:\/\/(?:tiebac|c\.tieba)\.baidu\.com\/c\/f\/ad\/getSplashAd(?:\?|$) - reject-dict

[Script]
百度贴吧_JSON信息流广告 = type=http-response,pattern=^https:\/\/(?:tiebac|c\.tieba)\.baidu\.com\/(?:c\/(?:s\/sync|f\/(?:ad\/getFeedAd|frs\/(?:page|threadlist|generalTabList)|pb\/(?:pic)?page|excellent\/personalized))|tiebaads\/commonbatch)(?:\?|$),requires-body=1,max-size=2097152,timeout=5,script-path=https://raw.githubusercontent.com/STERILITZIA02/Blockad-sr-my/v1.1.2/release/v1.1.2/scripts/blockad-router.js

[MITM]
hostname = %APPEND% c.tieba.baidu.com, tiebac.baidu.com
