[URL Rewrite]
# 启动页
^https:\/\/open\.qyer\.com\/qyer\/startpage(?:\/|\?|$) - reject-dict
# 广告素材
^https:\/\/media\.qyer\.com\/ad(?:\/|$) - reject-img

[MITM]
hostname = %APPEND% open.qyer.com, media.qyer.com
