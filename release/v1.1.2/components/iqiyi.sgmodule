[URL Rewrite]
# 新广告信息
^https:\/\/iface\.iqiyi\.com\/api\/getNewAdInfo(?:\?|$) - reject-dict
# 国际版广告
^https:\/\/intl\.iqiyi\.com\/(?:ad_external|video\/advertise)(?:\/|\?|$) - reject-dict

[MITM]
hostname = %APPEND% iface.iqiyi.com, intl.iqiyi.com
