#!name=BlockAd · 哔哩哔哩
#!desc=开屏、首页推荐流和标签配置中的显式广告；不修改会员、付费、登录或播放地址。
#!author=STERILITZIA02
#!homepage=https://github.com/STERILITZIA02/Blockad-sr-my
#!version=1.0.0
#!updated=2026-07-26
#!category=去广告

# GENERATED FILE — 请修改 config/apps.mjs 后重新构建。
# source-ref=v1.0.0

[URL Rewrite]
# 开屏配置
^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(?:list|show)(?:\?|$) - reject-dict
# 会员页广告素材上报（不修改会员状态）
^https:\/\/api\.bilibili\.com\/x\/vip\/ads\/material\/report(?:\?|$) - reject-dict
# 漫画闪屏广告
^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d+\.Comic\/(?:Flash|ListFlash)(?:\?|$) - reject-dict

[Script]
哔哩哔哩_推荐流显式广告 = type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/(?:v2\/feed\/index|resource\/show\/tab\/v2)(?:\?|$),requires-body=1,max-size=2097152,timeout=5,script-path=https://raw.githubusercontent.com/STERILITZIA02/Blockad-sr-my/v1.0.0/release/v1.0.0/scripts/blockad-router.js
哔哩哔哩_网页推荐流显式广告 = type=http-response,pattern=^https:\/\/api\.bilibili\.com\/(?:x\/web-interface\/index\/top\/feed\/rcmd|pgc\/season\/player\/cards)(?:\?|$),requires-body=1,max-size=2097152,timeout=5,script-path=https://raw.githubusercontent.com/STERILITZIA02/Blockad-sr-my/v1.0.0/release/v1.0.0/scripts/blockad-router.js
哔哩哔哩_直播与动态显式广告 = type=http-response,pattern=^https:\/\/(?:api\.live\.bilibili\.com\/xlive\/app-room\/v1\/index\/getInfoByRoom|api\.vc\.bilibili\.com\/dynamic_svr\/v1\/dynamic_svr\/dynamic_(?:history|new))(?:\?|$),requires-body=1,max-size=2097152,timeout=5,script-path=https://raw.githubusercontent.com/STERILITZIA02/Blockad-sr-my/v1.0.0/release/v1.0.0/scripts/blockad-router.js

[MITM]
hostname = %APPEND% app.bilibili.com, api.bilibili.com, api.live.bilibili.com, api.vc.bilibili.com, manga.bilibili.com
