[URL Rewrite]
# 消息页兴趣推荐
^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.playboy\.recommend\/(?:1|2)\.0 - reject-dict
# 搜索页发现/激活推荐
^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.(?:item\.search\.activate|search\.discover)\/ - reject-dict
# 我的页面商品推荐
^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.(?:buy\.feeds|recommend\.list) - reject-dict

[MITM]
hostname = %APPEND% acs.m.goofish.com
