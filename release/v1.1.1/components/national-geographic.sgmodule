[URL Rewrite]
# 广告接口
^https:\/\/dili\.bdatu\.com\/jiekou\/ad(?:\/|\?|$) - reject-dict
# 中国版广告
^https:\/\/wap\.ngchina\.cn\/news\/adverts(?:\/|\?|$) - reject-dict

[MITM]
hostname = %APPEND% dili.bdatu.com, wap.ngchina.cn
