[URL Rewrite]
# 小米金融广告
^https:\/\/api\.jr\.mi\.com\/v\d+\/adv(?:\/|\?|$) - reject-dict
# 小米金融开屏
^https:\/\/api\.jr\.mi\.com\/jr\/api\/playScreen(?:\?|$) - reject-dict
# 小米运动明确广告
^https:\/\/api-mifit(?:-[^/.]+)?\.huami\.com\/discovery\/mi\/discovery\/[^/?#]+_ad(?:\?|$) - reject-dict

[MITM]
hostname = %APPEND% api.jr.mi.com, api-mifit.huami.com, *.huami.com
